# Stack: directus-nextjs-trigger
# Copy to .env.trigger.local and start the dev server with it:
#   npx trigger.dev dev --env-file .env.trigger.local
#
# These are the variables the TASKS read. Values are literal on purpose: the Trigger.dev CLI loads dotenv
# files but does not expand ${VAR}. For deployed tasks set the same names in the Trigger.dev project, per
# environment (dashboard, `trigger env set`, or the syncEnvVars build extension).
# This file holds a token: keep it out of git (the name matches the .env*.local ignore pattern).

# Directus: the TASK user's token, not the Next.js server's and not an administrator's
DIRECTUS_URL=https://your-directus-instance.com
DIRECTUS_TOKEN=your-task-user-static-token

# Only for a task that calls /api/revalidate itself (the revalidation Flow normally covers a task's writes)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# REVALIDATION_SECRET=same-value-as-in-env-local

# Third-party keys a task uses (example)
# OPENAI_API_KEY=your-key
