# Stack: directus-nextjs-trigger
# Copy to .env.local (Next.js). The variables the tasks read are in .env.trigger.example.

# Directus (Data layer)
NEXT_PUBLIC_DIRECTUS_URL=https://your-directus-instance.com
# Static token of a dedicated Directus user whose policy grants only what the server code needs.
# An administrator token is acceptable for local development only.
DIRECTUS_ADMIN_TOKEN=your-directus-static-token
# The recipes of the directus-dev and nextjs-dev plugins read these names (lib/directus.ts, NextAuth,
# the images block of next.config.ts). Next.js expands ${VAR} inside .env files, so they follow the
# two variables above. Keep them. (The Trigger.dev CLI does NOT expand ${VAR}: tasks get their own file.)
DIRECTUS_URL=${NEXT_PUBLIC_DIRECTUS_URL}
DIRECTUS_TOKEN=${DIRECTUS_ADMIN_TOKEN}
NEXT_PUBLIC_CMS_URL=${NEXT_PUBLIC_DIRECTUS_URL}

# Address of this site: RSS links, metadata, and the call tasks make to /api/revalidate
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication: set the variables of the path you chose (see the authentication skill)
# NextAuth v4 (existing projects, credentials login against Directus)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Better Auth (recommended for new projects)
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Revalidation (a Directus Flow and the tasks call /api/revalidate with this value in the x-revalidate-secret header)
REVALIDATION_SECRET=generate-a-random-secret
# Job receiver (the Directus Flow that starts a task calls /api/directus-webhook/<collection> with this value
# in the x-webhook-secret header). A different value from REVALIDATION_SECRET: starting tasks costs money.
DIRECTUS_WEBHOOK_SECRET=generate-another-random-secret

# Asset proxy (only when files are not public): id of the Directus folder the proxy may serve
# PUBLIC_ASSET_FOLDER_ID=folder-uuid

# Deployment-specific env vars (VERCEL_*, DOKPLOY_*, etc.) are managed
# by your deployment plugin - not included here.

# Trigger.dev (self-hosted: background tasks and scheduled jobs)
#
# TRIGGER_API_URL - address of the self-hosted server. Set it wherever tasks.trigger() runs: without it the
#   SDK falls back to Trigger.dev Cloud and sends the key there.
# TRIGGER_SECRET_KEY - the environment secret key (tr_dev_... for dev) the SDK triggers tasks with.
# TRIGGER_ACCESS_TOKEN - Personal Access Token (tr_pat_...) for the Trigger.dev MCP server (see .mcp.json)
#   and for `trigger deploy` in CI. Dashboard -> Account -> Personal Access Tokens; the PAT's user must
#   belong to the organization that owns TRIGGER_PROJECT_REF.
TRIGGER_API_URL=https://trigger.example.com
TRIGGER_SECRET_KEY=tr_dev_your_dev_env_secret_key
TRIGGER_ACCESS_TOKEN=tr_pat_your_personal_access_token
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxx
# Optional: the version of your server, so the MCP server runs the matching CLI (default: latest)
# TRIGGER_CLI_VERSION=4.7.2
# Browser hooks (useRealtimeRun baseURL): an address, never a key
NEXT_PUBLIC_TRIGGER_API_URL=${TRIGGER_API_URL}
