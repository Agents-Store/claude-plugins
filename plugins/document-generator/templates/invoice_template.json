{
  "type": "invoice",
  "format": "pdf",
  "engine": "puppeteer",
  "structure": {
    "header": { "companyInfo": true, "logo": true },
    "invoiceMeta": ["invoiceNumber", "date", "dueDate"],
    "recipientBlock": true,
    "itemsTable": {
      "columns": [
        { "key": "description", "label": "Description", "width": "50%", "align": "left" },
        { "key": "quantity", "label": "Qty", "width": "10%", "align": "center" },
        { "key": "unitPrice", "label": "Unit Price", "width": "20%", "align": "right" },
        { "key": "total", "label": "Total", "width": "20%", "align": "right" }
      ]
    },
    "totalsBlock": ["subtotal", "tax", "discount", "total"],
    "paymentDetails": true,
    "qrCode": false,
    "notes": true
  },
  "styling": {
    "primaryColor": "#1E3A5F",
    "accentColor": "#2563EB",
    "backgroundColor": "#F8FAFC",
    "textColor": "#1E293B",
    "mutedColor": "#64748B",
    "borderColor": "#E2E8F0",
    "highlightBg": "#EFF6FF",
    "fontFamily": "'Inter', Arial, sans-serif",
    "fontHeading": "'PT Serif', Georgia, serif",
    "fontSizeTitle": "28px",
    "fontSizeBody": "13px",
    "fontSizeSmall": "11px",
    "tableHeaderBg": "#1E3A5F",
    "tableHeaderColor": "#FFFFFF",
    "tableStripeBg": "#F8FAFC",
    "pageSize": "A4",
    "margins": { "top": "28mm", "bottom": "22mm", "left": "18mm", "right": "18mm" }
  },
  "currency": "USD",
  "currencySymbol": "$"
}
