{
  "type": "invoice",
  "format": "pdf",
  "engine": "puppeteer",
  "structure": {
    "header": { "companyInfo": true, "logo": true },
    "invoiceMeta": ["invoiceNumber", "date", "dueDate"],
    "recipientBlock": true,
    "itemsTable": {
      "columns": [
        { "key": "description", "label": "Description", "width": "50%" },
        { "key": "quantity", "label": "Qty", "width": "10%", "align": "center" },
        { "key": "unitPrice", "label": "Unit Price", "width": "20%", "align": "right" },
        { "key": "total", "label": "Total", "width": "20%", "align": "right" }
      ]
    },
    "totalsBlock": ["subtotal", "tax", "discount", "total"],
    "paymentDetails": true,
    "qrCode": false,
    "notes": true
  },
  "styling": {
    "primaryColor": "#2563EB",
    "accentColor": "#F59E0B",
    "backgroundColor": "#FFFFFF",
    "fontFamily": "Helvetica, Arial, sans-serif",
    "fontSizeTitle": "24px",
    "fontSizeBody": "14px",
    "fontSizeSmall": "11px",
    "tableHeaderBg": "#2563EB",
    "tableHeaderColor": "#FFFFFF",
    "tableStripeBg": "#F8FAFC",
    "pageSize": "A4",
    "margins": { "top": "20mm", "bottom": "20mm", "left": "15mm", "right": "15mm" }
  },
  "currency": "USD",
  "currencySymbol": "$"
}
