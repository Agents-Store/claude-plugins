{
  "type": "report",
  "format": "docx",
  "structure": {
    "coverPage": true,
    "tableOfContents": true,
    "pageNumbers": true,
    "headerText": "{{title}} — {{date}}",
    "sections": [
      { "id": "introduction", "heading": "Introduction", "level": 1, "required": true },
      { "id": "background", "heading": "Background", "level": 1, "required": false },
      { "id": "methodology", "heading": "Methodology", "level": 1, "required": false },
      { "id": "findings", "heading": "Findings", "level": 1, "required": true },
      { "id": "analysis", "heading": "Analysis", "level": 1, "required": false },
      { "id": "conclusions", "heading": "Conclusions", "level": 1, "required": true },
      { "id": "recommendations", "heading": "Recommendations", "level": 1, "required": false },
      { "id": "appendices", "heading": "Appendices", "level": 1, "required": false },
      { "id": "references", "heading": "References", "level": 1, "required": false }
    ]
  },
  "styling": {
    "primaryColor": "#0F172A",
    "accentColor": "#6366F1",
    "backgroundColor": "#F8FAFC",
    "textColor": "#1E293B",
    "mutedColor": "#64748B",
    "borderColor": "#E2E8F0",
    "fontHeading": "Georgia",
    "fontBody": "Helvetica Neue",
    "fontBodyFallback": "Arial",
    "fontSizeTitle": 32,
    "fontSizeH1": 18,
    "fontSizeH2": 14,
    "fontSizeBody": 11,
    "lineSpacing": 1.3,
    "margins": { "top": 1440, "bottom": 1440, "left": 1080, "right": 1080 }
  },
  "footer": "{{companyName}}"
}
