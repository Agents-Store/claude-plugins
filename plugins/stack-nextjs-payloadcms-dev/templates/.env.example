# Stack: nextjs-payloadcms
# Process: dev
# Copy to the project root as .env and fill in real values. Never commit .env.

# ── App runtime ──────────────────────────────────────────────────────────────
DATABASE_URI=postgres://postgres:postgres@localhost:5432/app
PAYLOAD_SECRET=replace-me-openssl-rand-hex-32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Jobs Queue ───────────────────────────────────────────────────────────────
# 'true' on exactly one instance (or the worker container) — see background-job skill
ENABLE_JOBS=true

# ── Payload MCP (@payloadcms/plugin-mcp) ─────────────────────────────────────
# Install the plugin, then create a key in admin: MCP -> API Keys,
# and enable per-collection capabilities on that key.
PAYLOAD_MCP_URL=http://localhost:3000/api/mcp
PAYLOAD_MCP_API_KEY=replace-me

# ── Optional: S3-compatible storage (@payloadcms/storage-s3) ─────────────────
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Optional: SMTP email (@payloadcms/email-nodemailer) ──────────────────────
# SMTP_SERVER_URL=
# SMTP_SERVER_PORT=465
# SMTP_EMAIL=
# SMTP_EMAIL_PASSWORD=

# ── Optional: serverless cron auth for /api/payload-jobs/run ─────────────────
# CRON_SECRET=
