# Stack: composable-stack-v1
# Process: dev
# Architecture: PostgreSQL + NocoDB (Data) | n8n + Trigger.dev (Logic) | NocoBase + NocoDB (Interface)

# ── Trigger.dev (Logic layer — background tasks) ─────────────────────
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxx
TRIGGER_API_URL=https://your-trigger-instance.example.com

# ── n8n (Logic layer — workflow automation) ───────────────────────────
N8N_API_URL=https://your-n8n-instance.example.com
N8N_API_KEY=your-n8n-api-key

# n8n Native MCP (full URL including /mcp-server/http path)
N8N_NATIVE_MCP_URL=https://your-n8n-instance.example.com/mcp-server/http
N8N_MCP_TOKEN=your-n8n-mcp-bearer-token

# ── NocoDB (Data layer — tables and records) ──────────────────────────
NOCODB_MCP_URL=https://your-nocodb-mcp.example.com/mcp
NOCODB_TOKEN=your-nocodb-mcp-token

# ── PostgreSQL MCP (Data layer — direct database access) ─────────────
POSTGRESQL_MCP_URL=https://your-db-mcp.example.com/mcp
POSTGRESQL_MCP_TOKEN=your-postgresql-mcp-bearer-token

# ── PostgREST API (Data layer — REST API over PostgreSQL) ────────────
POSTGRESQL_API_URL=https://your-db-api.example.com
POSTGRESQL_API_TOKEN=your-postgrest-bearer-token

# ── NocoBase (Interface layer — UI and collections) ───────────────────
# Production instance — stable collections, released UI, live data
NOCOBASE_URL=https://your-nocobase-instance.example.com
NOCOBASE_API_KEY=your-nocobase-api-key

# ── NocoBase Dev (Interface layer — development sandbox) ──────────────
# Separate dev instance for building and testing new tables, UX elements,
# menus, pages, and workflows before promoting them to production.
# Also exposes API + MCP for development and test apps.
NOCOBASE_DEV_URL=https://your-nocobase-dev-instance.example.com
NOCOBASE_DEV_API_KEY=your-nocobase-dev-api-key
