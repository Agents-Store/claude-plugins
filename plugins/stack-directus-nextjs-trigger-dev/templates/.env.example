# Stack: directus-nextjs-trigger
# Process: dev

# Directus (Data layer)
NEXT_PUBLIC_DIRECTUS_URL=https://your-directus-instance.com
DIRECTUS_ADMIN_TOKEN=your-directus-static-token

# NextAuth (Authentication)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Revalidation (On-demand ISR via Directus webhooks)
REVALIDATION_SECRET=generate-a-random-secret

# Deployment-specific env vars (VERCEL_*, DOKPLOY_*, etc.) are managed
# by your deployment plugin — not included here.

# Trigger.dev (Self-hosted — background tasks + scheduled jobs)
#
# TRIGGER_SECRET_KEY is used both for SDK task triggering AND for the Trigger.dev
# MCP server auth (see .mcp.json — it is mapped into TRIGGER_ACCESS_TOKEN).
#
# Note: the MCP server normally expects a Personal Access Token (tr_pat_...) for
# TRIGGER_ACCESS_TOKEN, NOT an environment secret key (tr_dev_...). If MCP rejects
# the env secret key, create a PAT in the Trigger.dev dashboard (Settings →
# Personal Access Tokens) and put it here INSTEAD of the dev env secret. The
# SDK will still accept a PAT for task triggering.
TRIGGER_SECRET_KEY=tr_dev_your_dev_env_secret_key
TRIGGER_API_URL=https://trigger.your-domain.com
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxx
