# Stack: directus-nextjs-trigger
# Process: dev

# Directus (Data layer)
NEXT_PUBLIC_DIRECTUS_URL=https://your-directus-instance.com
DIRECTUS_ADMIN_TOKEN=your-directus-static-token

# NextAuth (Authentication)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Revalidation (On-demand ISR via Directus webhooks)
REVALIDATION_SECRET=generate-a-random-secret

# Deployment-specific env vars (VERCEL_*, DOKPLOY_*, etc.) are managed
# by your deployment plugin — not included here.

# Trigger.dev (Self-hosted — background tasks + scheduled jobs)
#
# TRIGGER_SECRET_KEY — environment secret key (tr_dev_...); the SDK triggers tasks with it.
# TRIGGER_ACCESS_TOKEN — Personal Access Token (tr_pat_...) for the Trigger.dev MCP server
# (see .mcp.json) and `trigger deploy`. Dashboard → Account → Personal Access Tokens; the
# PAT's user must belong to the organization that owns TRIGGER_PROJECT_REF.
TRIGGER_SECRET_KEY=tr_dev_your_dev_env_secret_key
TRIGGER_ACCESS_TOKEN=tr_pat_your_personal_access_token
TRIGGER_API_URL=https://trigger.your-domain.com
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxx
