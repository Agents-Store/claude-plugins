# ─────────────────────────────────────────────────────────────
# AGENTS.STORE plugin monorepo — env catalogue (documentation only)
#
# Real values live in Infisical (project "claude-plugins" on https://k.macstack.ai)
# and are mirrored into two generated, gitignored files:
#   • .env                        for shell tooling the plugins invoke (nb, gws,
#                                 docker compose, curl recipes in skills, …)
#   • .claude/settings.local.json for Claude Code — its `env` block is what the
#                                 ${VAR} placeholders in .mcp.json expand from
#
#   ./scripts/secrets-pull.sh          Infisical -> .env + settings.local.json
#   ./scripts/secrets-push.sh --yes    .env      -> Infisical (dry-run without --yes)
#   ./scripts/secrets-audit.sh         read-only drift report
#
# You do NOT need to `source .env` before launching claude — the settings env
# block is the source for the session. .env exists for everything outside it.
#
# Keys below are grouped by what consumes them. "MCP" means the root .mcp.json
# and/or a plugins/*/.mcp.json will not start that server without it.
# ─────────────────────────────────────────────────────────────

# ═════════ MCP servers ═══════════════════════════════════════
# Every variable in this block is referenced as ${VAR} by a .mcp.json.

# ── NocoBase (root nc-mcp, HTTP) ─────────────────────────────
NC_MCP_URL=https://your-nocobase.example.com/api/mcp
NC_MCP_TOKEN=replace-me
NC_MCP_PACKAGES=plugin-data-source-main,plugin-data-source-manager,plugin-workflow*,plugin-acl,plugin-users,plugin-auth,plugin-client,plugin-flow-engine,plugin-ai

# ── NocoBase (npx MCP, plugins/nocobase) ─────────────────────
NOCOBASE_URL=https://your-nocobase.example.com
NOCOBASE_EMAIL=admin@nocobase.com
NOCOBASE_PASSWORD=replace-me

# ── NocoBase Dev (HTTP, plugins/stack-composable-stack-v1) ───
NOCOBASE_DEV_URL=https://your-nocobase-dev.example.com
NOCOBASE_DEV_API_KEY=replace-me

# ── NocoDB (MCP pair) ────────────────────────────────────────
NOCODB_MCP_URL=https://your-nocodb.example.com/mcp/xxxxxxxx
NOCODB_MCP_TOKEN=replace-me
# plugins/stack-composable-stack-v1 passes this one to its MCP env block
NOCODB_TOKEN=replace-me

# ── Directus (MCP) ───────────────────────────────────────────
NEXT_PUBLIC_DIRECTUS_URL=https://your-directus.example.com
DIRECTUS_ADMIN_TOKEN=replace-me

# ── n8n ──────────────────────────────────────────────────────
N8N_MCP_URL=https://your-n8n.example.com/mcp
N8N_API_URL=https://your-n8n.example.com/api/v1
N8N_API_KEY=replace-me
N8N_NATIVE_MCP_URL=https://your-n8n.example.com/mcp/native
N8N_MCP_TOKEN=replace-me

# ── Trigger.dev ──────────────────────────────────────────────
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_SECRET_KEY=tr_dev_replace_me

# ── PostgreSQL MCP gateway ───────────────────────────────────
POSTGRESQL_MCP_URL=https://your-pg-mcp.example.com/mcp
POSTGRESQL_MCP_TOKEN=replace-me

# ── Dokploy ──────────────────────────────────────────────────
DOKPLOY_URL=https://your-dokploy.example.com
DOKPLOY_API_KEY=replace-me

# ── DataForSEO ───────────────────────────────────────────────
DATAFORSEO_USERNAME=replace-me
DATAFORSEO_PASSWORD=replace-me

# ── Search providers (web-search-dev) ────────────────────────
FIRECRAWL_MCP_URL=https://your-firecrawl.example.com/mcp
FIRECRAWL_API_TOKEN=fc-replace-me
EXA_API_KEY=replace-me
PERPLEXITY_API_KEY=pplx-replace-me
JINA_API_KEY=jina_replace_me
CONTEXT7_API_KEY=ctx7sk-replace-me

# ── Multi-bank ───────────────────────────────────────────────
MONOBANK_MCP_URL=https://your-bank-mcp.example.com/mcp/monobank
PRIVATBANK_MCP_URL=https://your-bank-mcp.example.com/mcp/privatbank

# ═════════ CLI / REST plugins (no MCP) ═══════════════════════
# Read straight from the environment by the plugin's skills and commands.

# ── nocobase-dev (nb CLI) ────────────────────────────────────
NB_URL=https://your-nocobase.example.com
NB_USER=admin@nocobase.com
NB_PASSWORD=replace-me
NB_TOKEN=replace-me

# ── nocodb-ops / nocodb-dev (REST, separate from the MCP pair)
NOCODB_URL=https://your-nocodb.example.com
NOCODB_API_TOKEN=replace-me

# ── directus-dev (short names used by its skills) ────────────
DIRECTUS_URL=https://your-directus.example.com
DIRECTUS_TOKEN=replace-me

# ── taiga-ops (REST API served under /api/v1) ────────────────
TAIGA_API_URL=https://your-taiga.example.com
TAIGA_ADMIN_USERNAME=admin
TAIGA_ADMIN_PASSWORD=replace-me
# TAIGA_AUTH_TOKEN is derived at runtime (POST /api/v1/auth)

# ── mattermost-ops (REST API served under /api/v4) ───────────
MATTERMOST_API_URL=https://your-mattermost.example.com
MATTERMOST_ADMIN_USERNAME=admin
MATTERMOST_ADMIN_PASSWORD=replace-me
# MATTERMOST_TOKEN is derived at runtime (Token header of POST /api/v4/users/login)

# ── atlassian-ops (Jira / Confluence Cloud, Basic auth) ──────
ATLASSIAN_SITE_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=replace-me
ATLASSIAN_API_TOKEN=replace-me

# ── chatwoot-dev ─────────────────────────────────────────────
CHATWOOT_BASE_URL=https://your-chatwoot.example.com
CHATWOOT_ACCOUNT_ID=replace-me
CHATWOOT_API_KEY=replace-me
CHATWOOT_PLATFORM_TOKEN=replace-me

# ── dify-dev ─────────────────────────────────────────────────
DIFY_BASE_URL=https://your-dify.example.com/v1
DIFY_API_KEY=app-replace-me
DIFY_USER=replace-me

# ── outline-ops ──────────────────────────────────────────────
OUTLINE_API_URL=https://your-outline.example.com/api
OUTLINE_API_KEY=replace-me

# ── google-workspace-dev (gws CLI) ───────────────────────────
GOOGLE_WORKSPACE_CLI_TOKEN=replace-me

# ── vercel-dev (Vercel CLI / REST) ───────────────────────────
VERCEL_TOKEN=replace-me

# ── openclaw-configurator ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-me
# Two distinct dirs for Docker deployments; both optional, both fall back to $(pwd).
#   INSTANCE_DIR: runtime workspace (openclaw.json, workspace/, agents/ …)
#     used by workspace-scan, config-validate, workspace-optimize, permission hook
OPENCLAW_INSTANCE_DIR=
#   PROJECT_DIR: git / docker-compose source, also the docker compose working dir
OPENCLAW_PROJECT_DIR=

# ── infisical-dev + the scripts in scripts/ ──────────────────
INFISICAL_DOMAIN=https://k.macstack.ai

# ── plugin-creator / project-template-creator cross-repo paths
PLUGINS_PUBLIC_SOURCE_DIR=/path/to/claude-public-plugins/plugins
PLUGINS_PRIVATE_SOURCE_DIR=/path/to/claude-plugins-private/plugins
PROJECT_TEMPLATES_DIR=/path/to/STACKMAKERS

# ═════════ Set on the target host, not here ══════════════════
# Documented for reference — these belong to the machine a plugin operates on,
# so they are deliberately NOT kept in this repo's Infisical project.
#
# restic-dev (backup host):
#   RESTIC_REPOSITORY, RESTIC_PASSWORD_FILE, RESTIC_COMPRESSION, RESTIC_CACHE_DIR,
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION   (Cloudflare R2)
# nocobase-dev (direct DB access, optional):
#   NB_DB_HOST, NB_DB_PORT, NB_DB_NAME, NB_DB_USER, NB_DB_PASSWORD, NB_DEBUG
# dify-ops (self-hosted Dify checkout):
#   DIFY_ROOT, NGINX_PORT, NGINX_SSL_PORT
# infisical-dev (machine-identity auth in CI):
#   INFISICAL_TOKEN, INFISICAL_CLIENT_ID, INFISICAL_CLIENT_SECRET, INFISICAL_API_URL
# google-workspace-dev (OAuth client file):
#   GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE, GOOGLE_WORKSPACE_CLI_CONFIG_DIR
