# ─────────────────────────────────────────────────────────────
# AGENTS.STORE plugin monorepo — env template (documentation)
#
# Real values live in Infisical and are pulled into:
#   • .env                        (for docker compose, openclaw CLI, nb CLI, etc.)
#   • .claude/settings.local.json (env-block consumed by Claude Code + .mcp.json)
#
# Generate both with:
#   ./scripts/setup.sh dev .env .claude/settings.local.json
#
# Claude Code reads ${VAR} placeholders in .mcp.json from the env-block in
# settings.local.json — you do NOT need to source .env before launching claude.
# .env exists for shell tools that the plugins themselves invoke.
# ─────────────────────────────────────────────────────────────

# ── NocoBase (root nc-mcp, HTTP) ─────────────────────────────
NC_MCP_URL=https://your-nocobase.example.com/api/mcp
NC_MCP_TOKEN=replace-me
NC_MCP_PACKAGES=plugin-data-source-main,plugin-data-source-manager,plugin-workflow*,plugin-acl,plugin-users,plugin-auth,plugin-client,plugin-flow-engine,plugin-ai

# ── NocoBase (npx MCP, plugins/nocobase) ─────────────────────
NOCOBASE_URL=https://your-nocobase.example.com:13000
NOCOBASE_EMAIL=admin@nocobase.com
NOCOBASE_PASSWORD=replace-me

# ── NocoBase Dev (HTTP, used by stack-composable) ────────────
NOCOBASE_DEV_URL=https://your-nocobase-dev.example.com
NOCOBASE_DEV_API_KEY=replace-me

# ── NocoBase CLI (nb CLI, used by nocobase-dev) ──────────────
NB_URL=https://your-nocobase.example.com
NB_USER=admin@nocobase.com
NB_PASSWORD=replace-me
NB_TOKEN=replace-me

# ── NocoDB ───────────────────────────────────────────────────
NOCODB_MCP_URL=https://your-nocodb.example.com/api/v3/mcp
NOCODB_MCP_TOKEN=replace-me
NOCODB_TOKEN=replace-me

# ── Directus ─────────────────────────────────────────────────
NEXT_PUBLIC_DIRECTUS_URL=https://your-directus.example.com
DIRECTUS_ADMIN_TOKEN=replace-me

# ── n8n ──────────────────────────────────────────────────────
N8N_MCP_URL=https://your-n8n.example.com/mcp
N8N_API_URL=https://your-n8n.example.com/api/v1
N8N_API_KEY=replace-me
N8N_NATIVE_MCP_URL=https://your-n8n.example.com/mcp/native
N8N_MCP_TOKEN=replace-me

# ── Trigger.dev ──────────────────────────────────────────────
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_SECRET_KEY=tr_dev_replace_me

# ── PostgreSQL MCP gateway ───────────────────────────────────
POSTGRESQL_MCP_URL=https://your-pg-mcp.example.com/mcp
POSTGRESQL_MCP_TOKEN=replace-me

# ── Dokploy ──────────────────────────────────────────────────
DOKPLOY_URL=https://your-dokploy.example.com
DOKPLOY_API_KEY=replace-me

# ── Taiga (REST API, plugins/taiga-ops) ──────────────────────
# Instance root (API served under /api/v1). Hosted: https://api.taiga.io
TAIGA_API_URL=https://your-taiga.example.com
TAIGA_ADMIN_USERNAME=admin
TAIGA_ADMIN_PASSWORD=replace-me
# TAIGA_AUTH_TOKEN is derived at runtime from the username/password above (POST /api/v1/auth)

# ── DataForSEO ───────────────────────────────────────────────
DATAFORSEO_USERNAME=replace-me
DATAFORSEO_PASSWORD=replace-me

# ── Firecrawl (self-hosted MCP for plugins/firecrawl) ────────
FIRECRAWL_MCP_URL=https://your-firecrawl.example.com/mcp

# ── Search providers (web-search-dev) ────────────────────────
FIRECRAWL_API_TOKEN=fc-replace-me
EXA_API_KEY=replace-me
PERPLEXITY_API_KEY=pplx-replace-me
JINA_API_KEY=jina_replace_me
CONTEXT7_API_KEY=replace-me

# ── Multi-bank ───────────────────────────────────────────────
MONOBANK_MCP_URL=https://your-bank-mcp.example.com/mcp/monobank
PRIVATBANK_MCP_URL=https://your-bank-mcp.example.com/mcp/privatbank

# ── OpenClaw — path-anchored plugin ──────────────────────────
# Two distinct dirs for Docker deployments. Both optional.
#
# INSTANCE_DIR: runtime workspace (openclaw.json, workspace/, agents/, ...)
#   Used by workspace-scan, config-validate, workspace-optimize, permission hook.
#   Typical: /root/.openclaw-{name}/
OPENCLAW_INSTANCE_DIR=
#
# PROJECT_DIR: git/docker-compose source (docker-compose.yaml, migrations)
#   Used by instance-update and as the docker compose working dir.
#   Typical: /docker/openclaw-{name}/
OPENCLAW_PROJECT_DIR=
#
# Infisical self-hosted domain — used by the /infisical-migrate command (Goal 4).
#   Machine-identity creds (INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET) live in
#   /etc/openclaw/infisical.env on the host (mode 600) — NOT in this repo.
INFISICAL_DOMAIN=https://k.macstack.ai
